# Copie para .env. Não commite o .env.
# Nenhum número real. O chip do bot é um número novo — leia o aviso no README.
# O teste grátis não é variável de ambiente: 1 figurinha em src/config.ts (trial.freeStickers). 0 desliga.

# HTTP. No Render a plataforma define PORT; localmente o padrão é 8787.
PORT=8787
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
# silent | warn | info. A lib do WhatsApp é barulhenta; deixe silent.
BAILEYS_LOG_LEVEL=silent

# Obrigatório. Token longo e aleatório. Protege /qr e o reset da sessão.
ADMIN_TOKEN=troque-por-um-token-longo-aleatorio

# Admins, só dígitos com DDI, separados por vírgula.
# Defina no deploy. Não grave o número neste arquivo.
ADMIN_NUMBERS=

# 1 = não abre socket do WhatsApp (testes e demo). No Render use 0.
MOCK_WHATSAPP=1
# 1 = Pix falso, sem chamar o Mercado Pago. No Render use 0.
MOCK_MP=1

# Local: arquivo. Render: libsql://...turso.io (o disco de lá é efêmero).
LIBSQL_URL=file:local.db
LIBSQL_AUTH_TOKEN=

# Credencial de TESTE (começa com TEST-). Não use o token de produção.
MP_ACCESS_TOKEN=
# Segredo de assinatura do webhook, no painel do Mercado Pago.
MP_WEBHOOK_SECRET=troque-por-outro-segredo
# E-mail de um usuário de teste criado no painel. Não use e-mail pessoal.
MP_PAYER_EMAIL=pagador.sandbox@example.com
# APRO é o nome que o sandbox trata como pagamento aprovado.
MP_PAYER_FIRST_NAME=APRO
# URL pública sem barra no fim, para o Mercado Pago chamar o webhook.
# PUBLIC_BASE_URL=https://seu-app.onrender.com
PUBLIC_BASE_URL=

# Número NOVO do chip, só dígitos com DDI, sem +. Exemplo fictício.
# PAIRING_NUMBER=5511900000000
PAIRING_NUMBER=

# Opcional. Se vazio, o bot escolhe bin/ffmpeg, o ffmpeg-static ou o ffmpeg do PATH.
FFMPEG_PATH=

# 1 (padrão) manda figurinha com som quando o vídeo tem áudio. 0 desliga no servidor.
SOUND_STICKERS=1

# Painel de contatos em /admin. Se a senha estiver vazia, a rota responde 404.
ADMIN_PASSWORD=
# Segredo longo e aleatório que assina o cookie da sessão. Use junto com ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=
